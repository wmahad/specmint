{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["Cargo.toml", "Cargo.lock"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/crates/**"],
      "outputs": ["*.node", "index.js", "index.d.ts"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
