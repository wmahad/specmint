{
  "name": "specmint-monorepo",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all -- --check",
    "clean": "pnpm -r run clean && cargo clean"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
